<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<?import javafx.scene.image.Image?>

<!--TODO надо убрать отсюда иконки. Так как они размерные, будем их заполнять в коде -->
<!--TODO а нужны ли вообще размерные иконки?-->
<fx:root xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         type="javafx.scene.layout.HBox"
         prefHeight="30.0" prefWidth="600.0"
         spacing="5"
         alignment="CENTER_LEFT"
         stylesheets="@/styles/controlPanel.css"
         styleClass="main-widget">

    <padding>
        <Insets bottom="5" top="5" left="5"/>
    </padding>

    <!--Комбобокс с выбором диска. Не актуален для Linux-->
    <ImageView HBox.hgrow="ALWAYS" fx:id="diskIcon">
        <Image url="/icons/24x24/disk.png"/>
    </ImageView>
    <ComboBox fx:id="diskComboBox" HBox.hgrow="ALWAYS" onAction="#onSelectLogicalDrive" styleClass="add-button"/>

    <!--Кнопка создать-->
    <MenuButton textAlignment="RIGHT" fx:id="createButton" HBox.hgrow="ALWAYS">
        <!-- Меню -->
         <items>
            <!-- Создать папку -->
            <MenuItem fx:id="createFolderMenuItem" text="%addmenu.item.folder" onAction="#onCreateFolderItemClick">
                <graphic>
                    <ImageView>
                        <Image url="/icons/16x16/folder.png"/>
                    </ImageView>
                </graphic>
            </MenuItem>

            <!-- Создать текстовый файл -->
             <MenuItem fx:id="createTextFileMenuItem" text="%addmenu.item.textfile" onAction="#onCreateTextFileItemClick">
                <graphic>
                    <ImageView>
                        <Image url="/icons/16x16/file.png"/>
                    </ImageView>
                </graphic>
             </MenuItem>

         </items>
        
        <!-- Иконка -->
         <graphic>
            <ImageView>
                <Image url="/icons/24x24/add.png" preserveRatio="true"/>
            </ImageView>
         </graphic>

        <!-- Подсказка при наведении -->
        <tooltip>
            <Tooltip text="%button.add.tooltip"/>
        </tooltip>
    </MenuButton>

    <!-- Кнопки навигации -->
     <HBox spacing="0" alignment="CENTER_LEFT" styleClass="nav-button-group">
        <!--Кнопка "Назад"-->
        <Button fx:id="backButton" HBox.hgrow="ALWAYS" minWidth="30" maxWidth="30" disable="true" styleClass="nav-btn-left">
            <graphic>
                <ImageView>
                    <Image url="/icons/24x24/back_arrow.png" preserveRatio="true"/>
                </ImageView>
            </graphic>
            <tooltip>
                <Tooltip text="%button.back.tooltip"/>
            </tooltip>
        </Button>

        <!--Кнопка "Вперёд"-->
        <Button fx:id="forwardButton" HBox.hgrow="ALWAYS" minWidth="30" maxWidth="30" disable="true" styleClass="nav-btn-right">
            <graphic>
                <ImageView>
                    <Image url="/icons/24x24/forward_arrow.png" preserveRatio="true"/>
                </ImageView>
            </graphic>
            <tooltip>
                <Tooltip text="%button.forward.tooltip"/>
            </tooltip>
        </Button>
     </HBox>

    <!--Кнопка вставки-->
    <Button fx:id="insertButton" HBox.hgrow="ALWAYS" disable="true">
        <graphic>
            <ImageView>
                <Image url="/icons/24x24/insert.png" preserveRatio="true"/>
            </ImageView>
        </graphic>
        <tooltip>
            <Tooltip text="%button.insert.tooltip"/>
        </tooltip>
    </Button>

    <!--Поле поиска-->
    <TextField fx:id="searchField" HBox.hgrow="ALWAYS" editable="true" styleClass="search-field">
        <tooltip>
            <Tooltip text="%textfield.currentPath.tooltip"/>
        </tooltip>
    </TextField>
</fx:root>
