<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.SettingsController"
      prefHeight="400.0" prefWidth="600.0">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <GridPane>
        <padding>
            <Insets bottom="10"/>
        </padding>
        <Label text="%settings.language.title" fx:id="languageSettingsTitle" GridPane.rowIndex="0" GridPane.columnIndex="0"
               GridPane.columnSpan="2" style="-fx-font-weight: bold">
            <GridPane.margin>
                <Insets bottom="10"/>
            </GridPane.margin>
        </Label>

        <Label fx:id="languageLabel" text="%settings.label.language" GridPane.rowIndex="1" GridPane.columnIndex="0"
               GridPane.halignment="RIGHT">
            <GridPane.margin>
                <Insets right="10"/>
            </GridPane.margin>
        </Label>

        <ComboBox fx:id="localeBox" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>
    </GridPane>

    <Separator fx:id="linuxSettingsSeparator"/>

    <GridPane fx:id="linuxSettings">
        <Label text="%settings.linux.title" fx:id="linuxSettingsTitle" GridPane.rowIndex="0" GridPane.columnIndex="0"
               GridPane.columnSpan="2" style="-fx-font-weight: bold">
            <GridPane.margin>
                <Insets bottom="10"/>
            </GridPane.margin>
        </Label>

        <Label text="%settings.linux.used_terminal" fx:id="linuxUsedTerminalLabel" GridPane.rowIndex="1"
               GridPane.columnIndex="0">
            <GridPane.margin>
                <Insets right="10"/>
            </GridPane.margin>
        </Label>

        <TextField fx:id="terminalTextField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%settings.linux.open_command" fx:id="linuxOpenCommandLabel" GridPane.rowIndex="2" GridPane.columnIndex="0">
            <GridPane.margin>
                <Insets right="10"/>
            </GridPane.margin>
        </Label>

        <TextField fx:id="openCommandTextField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS" spacing="5">
        <Button fx:id="saveButton" text="%settings.button.save" minWidth="80" textAlignment="CENTER"/>
        <Button fx:id="applyButton" text="%settings.button.apply" minWidth="80" textAlignment="CENTER"/>
        <Button fx:id="cancelButton" text="%settings.button.cancel" minWidth="80" textAlignment="CENTER"/>
    </HBox>

</VBox>
