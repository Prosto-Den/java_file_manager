<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.MainController">

    <children>
        <!--Панель инструментов файлового менеджера-->
        <fx:include source="ToolBar.fxml" VBox.vgrow="ALWAYS"/>

        <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS">
            <items>
                <TabPane fx:id="leftTabPane" tabClosingPolicy="ALL_TABS"/>
                <TabPane fx:id="rightTabPane" tabClosingPolicy="ALL_TABS"/>
            </items>
        </SplitPane>

        <!-- HBox VBox.vgrow="ALWAYS" -->
            <!--Метка HBox.hgrow="ALWAYS" позволяет виджету растягиваться по горизонтали !-->
            <!--Левая панель-->
            <!-- BorderPane HBox.hgrow="ALWAYS" fx:id="leftContainer"/ -->
            <!--Правая панель-->
            <!-- BorderPane HBox.hgrow="ALWAYS" fx:id="rightContainer"/-->
        <!--/HBox-->
    </children>
</VBox>
